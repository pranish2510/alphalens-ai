# ─── AlphaLens AI — Environment Variables ────────────────────────────────────
# Copy this file to .env.local and fill in your keys

# ── REQUIRED: Finnhub (free at https://finnhub.io/register) ──────────────────
# Used for: US stock quotes, NSE/BSE search, analyst ratings, company news
FINNHUB_API_KEY=your_finnhub_key_here

# ── REQUIRED: At least ONE AI provider ───────────────────────────────────────

# Option A — OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Option B — Google Gemini (https://aistudio.google.com/app/apikey)  
GEMINI_API_KEY=AIza...

# Which AI to use: "openai" or "gemini" (default: openai)
AI_PROVIDER=openai

# ── NOTE ─────────────────────────────────────────────────────────────────────
# Indian NSE stocks use Yahoo Finance public endpoint (no key needed).
# US stocks use Finnhub exclusively.
